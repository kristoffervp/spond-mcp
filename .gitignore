# Explicit public-file allowlist. Sessions, recon dumps, and local notes stay out of Git.
/*
!/.gitignore
!/.github/
/.github/*
!/.github/workflows/
!/LICENSE
!/assets/
/assets/*
!/assets/banner.jpg
!/README.md
!/README.no.md
!/CHANGELOG.md
!/CHANGELOG.no.md
!/SECURITY.md
!/package.json
!/package-lock.json
!/src/
/src/*
!/src/auth.js
!/src/errors.js
!/src/login.js
!/src/mcp-format.js
!/src/paths.js
!/src/server.js
!/src/sending.js
!/src/spond.js
!/test/
/test/*
!/test/auth.test.js
!/test/mcp-format.test.js
!/test/server.test.js
!/test/sending.test.js
!/test/spond.test.js
